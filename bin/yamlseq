#!/usr/bin/env bash
#
# yamlseq KEY FILE
#
# publications.yaml and talks.yaml are bare YAML sequences, but pandoc's
# --metadata-file requires a mapping at the root. Wrap the sequence under KEY
# and order the entries by their `date:` field, newest first (what Quarto's
# `sort: "date desc"` used to do).
#
# Each record is written to a file named "<date>-<nnn>" so that sorting the
# filenames sorts the records; dates are ISO so lexical order is chronological
# and the index keeps entries sharing a date stable.

set -euo pipefail

key=$1
file=$2

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

awk -v out="$tmp" '
  /^- / { n++ }
  n > 0 { rec[n] = rec[n] $0 "\n" }
  /^[[:space:]]*date:[[:space:]]*/ {
    d = $0
    sub(/^[[:space:]]*date:[[:space:]]*/, "", d)
    gsub(/"/, "", d)
    sub(/[[:space:]]+$/, "", d)
    if (key[n] == "") key[n] = d
  }
  END {
    for (i = 1; i <= n; i++) {
      f = sprintf("%s/%s-%03d", out, key[i], i)
      printf "%s", rec[i] > f
    }
  }
' "$file"

printf '%s:\n' "$key"
find "$tmp" -type f | sort -r | while read -r f; do
  sed 's/^./  &/' "$f"
done
