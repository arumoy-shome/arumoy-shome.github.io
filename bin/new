#!/usr/bin/env python3
"""new: scaffold a blog post.

Ported from the archive's bin/new. The archive encoded the date and type in
the filename (YYYY-MM-DD--blog--title); posts now live in a directory named
after the slug, with the date in the frontmatter and images alongside the
markdown, so the filename carries only the slug.
"""

import argparse
import os
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

parser = argparse.ArgumentParser(description="Create a new blog post.")
parser.add_argument("title", help="Title of the new post")
parser.add_argument("-d", "--date", help="Date in YYYY-MM-DD format (default: today)")
parser.add_argument("-c", "--categories", help="Comma-separated categories")
parser.add_argument("-x", "--noedit", action="store_true",
                    help="Do not open the new file in $EDITOR")
parser.add_argument("-f", "--force", action="store_true",
                    help="Do not ask for confirmation")
args = parser.parse_args()

when = args.date or date.today().isoformat()
slug = re.sub(r"[^a-z0-9]+", "-", args.title.strip().lower()).strip("-")
post = Path("blogs") / slug / "index.md"

cats = [c.strip() for c in (args.categories or "").split(",") if c.strip()]
cats_line = "categories: [{}]\n".format(", ".join(f'"{c}"' for c in cats)) if cats else ""

frontmatter = (
    "---\n"
    f"title: {args.title}\n"
    f"date: {when}\n"
    "abstract: |\n"
    "    \n"
    f"{cats_line}"
    "---\n\n"
)

if not args.force:
    reply = input(f"Create {post}? [y]es/[n]o: ").strip().lower()
    if not reply.startswith("y"):
        sys.exit("Terminated by user")

if post.exists():
    sys.exit(f"{post} already exists")

post.parent.mkdir(parents=True, exist_ok=True)
post.write_text(frontmatter)

if not args.noedit:
    editor = os.getenv("EDITOR")
    if editor:
        subprocess.run([editor, str(post)])

print(f"{post} created")
