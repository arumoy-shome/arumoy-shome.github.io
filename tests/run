#!/usr/bin/env bash
#
# run: the test driver.
#
#   tests/run                  every test file
#   tests/run 4                only tests/4*.sh
#   tests/run links slugify    match by name substring too
#   tests/run --update-golden  regenerate tests/golden/site-manifest.txt
#
# TEST_FAST=1 skips the rebuild-heavy invariant tests (40-42), which dominate
# the runtime. SKIP_BUILD=1 skips the up-front `make`, for when _site is known
# to be current.
#
# Each test file runs as its own bash process with REPO_ROOT, TESTDIR, TMP and
# COUNT_FILE exported, so a file that aborts takes only itself down. Assertion
# counts come back through COUNT_FILE; see tests/lib.sh.

set -uo pipefail

cd "$(dirname "$0")/.."
REPO_ROOT=$PWD
TESTDIR=$REPO_ROOT/tests
export REPO_ROOT TESTDIR

TMPROOT=$(mktemp -d "${TMPDIR:-/tmp}/wwwtest.XXXXXX")
trap 'rm -rf "$TMPROOT"' EXIT

if [[ -t 1 ]]; then
  R=$(printf '\033[31m'); G=$(printf '\033[32m'); Y=$(printf '\033[33m')
  D=$(printf '\033[2m'); B=$(printf '\033[1m'); N=$(printf '\033[0m')
else
  R=""; G=""; Y=""; D=""; B=""; N=""
fi

update_golden() {
  mkdir -p "$TESTDIR/golden"
  (cd "$REPO_ROOT/_site" && find . -type f | sort) >"$TESTDIR/golden/site-manifest.txt"
  printf 'wrote %s (%d entries)\n' "tests/golden/site-manifest.txt" \
    "$(wc -l <"$TESTDIR/golden/site-manifest.txt" | tr -d ' ')"
}

filters=()
do_golden=""
for arg in "$@"; do
  case $arg in
    --update-golden) do_golden=1 ;;
    -h|--help) sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) filters+=("$arg") ;;
  esac
done

# --- build once -----------------------------------------------------------
# Whole-site tests read _site. A no-op make is instant, so this is cheap when
# the tree is already current and makes `tests/run` usable on its own.
if [[ -z ${SKIP_BUILD:-} ]]; then
  if ! make -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)" >"$TMPROOT/build.log" 2>&1; then
    printf '%sbuild failed; tests need a built _site%s\n' "$R" "$N" >&2
    cat "$TMPROOT/build.log" >&2
    exit 1
  fi
fi

if [[ -n $do_golden ]]; then update_golden; exit 0; fi

# --- collect --------------------------------------------------------------
files=()
for f in "$TESTDIR"/[0-9]*.sh; do
  [[ -f $f ]] || continue
  if (( ${#filters[@]} > 0 )); then
    keep=""
    for pat in "${filters[@]}"; do
      case $(basename "$f") in *"$pat"*) keep=1 ;; esac
    done
    [[ -n $keep ]] || continue
  fi
  files+=("$f")
done

if (( ${#files[@]} == 0 )); then
  printf 'no test files matched\n' >&2
  exit 1
fi

# --- header ---------------------------------------------------------------
# The pandoc version is printed because local (3.10.x) and CI (pinned 3.7.0.2)
# differ, and version skew is the likeliest cause of a puzzling failure.
printf '%s%s%s\n' "$D" "$(pandoc --version | head -1)" "$N"
printf '%sbash %s · %s%s\n' "$D" "${BASH_VERSION%%(*}" "$(uname -s)" "$N"
if command -v xmllint >/dev/null 2>&1; then :; else
  printf '%sxmllint not found — XML well-formedness checks will skip%s\n' "$Y" "$N"
fi
printf '\n'

# --- run ------------------------------------------------------------------
started=$(date +%s)
n_pass=0; n_fail=0; n_skip=0; a_pass=0; a_fail=0
failed_files=()

for f in "${files[@]}"; do
  name=$(basename "$f")
  short=${name%.sh}

  if [[ -n ${TEST_FAST:-} ]] && [[ $name == 4* ]]; then
    printf '%sskip%s  %-26s %s(TEST_FAST=1)%s\n' "$Y" "$N" "$short" "$D" "$N"
    n_skip=$((n_skip + 1))
    continue
  fi

  tmp=$TMPROOT/$short
  counts=$TMPROOT/counts.$short
  mkdir -p "$tmp"

  TMP=$tmp COUNT_FILE=$counts bash "$f"
  rc=$?

  p=0; fl=0; sk=0; reason=""
  if [[ -f $counts ]]; then read -r p fl sk reason <"$counts"; fi
  a_pass=$((a_pass + p)); a_fail=$((a_fail + fl))

  if (( sk == 1 )); then
    printf '%sskip%s  %-26s %s%s%s\n' "$Y" "$N" "$short" "$D" "$reason" "$N"
    n_skip=$((n_skip + 1))
  elif (( rc == 0 && fl == 0 )); then
    printf '%sok%s    %-26s %s%d assertions%s\n' "$G" "$N" "$short" "$D" "$p" "$N"
    n_pass=$((n_pass + 1))
  else
    printf '%s%sFAIL%s  %-26s %s%d of %d assertions failed%s\n' \
      "$B" "$R" "$N" "$short" "$D" "$fl" "$((p + fl))" "$N"
    n_fail=$((n_fail + 1))
    failed_files+=("$short")
  fi
done

elapsed=$(( $(date +%s) - started ))

printf '\n'
if (( n_fail > 0 )); then
  printf '%s%d file(s) failed:%s %s\n' "$R" "$n_fail" "$N" "${failed_files[*]}"
fi
printf '%d passed, %d failed, %d skipped · %d assertions (%d failed) · %ds\n' \
  "$n_pass" "$n_fail" "$n_skip" "$((a_pass + a_fail))" "$a_fail" "$elapsed"

(( n_fail == 0 ))
